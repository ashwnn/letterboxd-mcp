# Copy this file to .dev.vars for local development.
# Keep .dev.vars private and never commit it.
# Fill in the values you need; test and typecheck do not require Letterboxd credentials.

# Required for the owner authorization flow.
ADMIN_PASSWORD=""

# Required for live Letterboxd account linking.
# Request API access at https://letterboxd.com/api-beta/
LETTERBOXD_CLIENT_ID=""
LETTERBOXD_CLIENT_SECRET=""

# Required for /letterboxd/relink. Generate with: openssl rand -hex 32
COOKIE_SIGNING_KEY=""

# Optional overrides for local browser-based OAuth flows:
# PUBLIC_URL="http://localhost:8787"
# ENVIRONMENT="dev"
