{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "letterboxd-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "PUBLIC_URL": "https://letterboxd-mcp.<account>.workers.dev",
    "TIMEZONE": "America/Vancouver",
    "READ_ONLY": "false",
    "ALLOWED_REDIRECT_HOSTS": "claude.ai,claude.com,chatgpt.com",
    "ENVIRONMENT": "production"
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_OAUTH_KV_ID" },
    { "binding": "LOOKUP_KV", "id": "REPLACE_WITH_LOOKUP_KV_ID" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LB_TOKENS", "class_name": "LetterboxdTokenStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LetterboxdTokenStore"] }],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
